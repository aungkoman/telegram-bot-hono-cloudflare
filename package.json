{
  "name": "predict-league-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute predict-league-db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute predict-league-db --remote --file=./migrations/0001_init.sql",
    "set-webhook": "node --env-file=.dev.vars scripts/set-webhook.mjs",
    "delete-webhook": "node scripts/delete-webhook.mjs",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}